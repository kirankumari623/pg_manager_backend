# Copy this file to .env and fill in the values.

# PostgreSQL connection string (from Neon, Supabase, or a local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins (use * during early development)
CORS_ORIGIN="*"

# Email. "console" prints emails in the terminal (good for testing, needs no setup).
# To really send emails, set EMAIL_PROVIDER=smtp and fill in the SMTP_* lines.
EMAIL_PROVIDER=console
EMAIL_FROM="Sunrise PG <you@gmail.com>"
# Gmail example (needs 2-step verification on and an "App password"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password

# The daily automation job (creates monthly rent bills and sends reminders for owners who switched it on).
# Default: every day at 9:00 AM India time. Set SCHEDULER_ENABLED=false to turn the job off.
# SCHEDULER_ENABLED=true
# SCHEDULER_CRON="0 9 * * *"

# Hosting. Only needed on a server that sleeps (e.g. Render free plan).
# An outside timer calls POST /api/internal/run-daily with header "x-cron-secret: <this value>".
# CRON_SECRET=make-this-a-long-random-string
